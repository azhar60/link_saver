<% content_for :title, "Edit link" %>

<div class="max-w-2xl mx-auto">
  <div class="mb-6">
    <h1 class="text-3xl font-bold tracking-tight text-mist-100">Edit link</h1>
    <p class="text-sm text-mist-400 mt-1 line-clamp-1"><%= @link.title.presence || @link.url %></p>
  </div>

  <div class="glass-strong rounded-2xl p-6 sm:p-8 shadow-glass">
    <%= render "form", link: @link %>
  </div>
</div>
