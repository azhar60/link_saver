<%# locals: (link:) %>
<% if link.tag_list.any? %>
  <div class="flex flex-wrap gap-1.5">
    <% link.tag_list.each do |tag| %>
      <%= link_to tag, links_path(tag: tag), class: "text-xs px-2 py-0.5 rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200 transition" %>
    <% end %>
  </div>
<% end %>
