<% content_for :title, "Links" %>

<%= turbo_stream_from "links" %>

<div>
  <% if notice.present? %>
    <div class="alert alert-success mb-5" id="notice"><%= notice %></div>
  <% end %>

  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-6">
    <div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">
        <span class="text-gradient"><%= @show_archived ? "Archive" : "Your library" %></span>
      </h1>
      <p class="text-sm text-mist-400 mt-1">
        <%= @show_archived ? "Links you've finished with." : "Saved links, summarized by AI." %>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-3 text-sm">
      <% if @show_archived %>
        <%= link_to "← Back to active", links_path, class: "text-mist-300 hover:text-mist-100" %>
      <% else %>
        <%= link_to "Archive →", links_path(archived: true), class: "text-mist-300 hover:text-mist-100" %>
        <span class="text-mist-500">·</span>
        <%= link_to "Export JSON", export_links_path(format: :json), class: "text-mist-300 hover:text-mist-100" %>
        <%= link_to "Export CSV",  export_links_path(format: :csv),  class: "text-mist-300 hover:text-mist-100" %>
      <% end %>
    </div>
  </div>

  <%= form_with url: links_path, method: :get, data: { turbo_frame: "links_frame" }, class: "mb-5" do |f| %>
    <%= hidden_field_tag :tag, @tag if @tag %>
    <%= hidden_field_tag :archived, @show_archived if @show_archived %>
    <div class="relative">
      <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-mist-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <%= f.search_field :q, value: @query, placeholder: "Search title or summary…", class: "input pl-10" %>
    </div>
  <% end %>

  <% if @tag %>
    <div class="flex items-center gap-2 mb-5 text-sm">
      <span class="text-mist-400">Filtered by tag:</span>
      <span class="chip chip-processing"><%= @tag %></span>
      <%= link_to "Clear", links_path(q: @query), class: "text-mist-400 hover:text-mist-100 underline" %>
    </div>
  <% end %>

  <%= turbo_frame_tag "links_frame" do %>
    <% if @links.any? %>
      <div id="links" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <%= render @links %>
      </div>

      <% if @pagy.pages > 1 %>
        <nav class="pagy-wrap" aria-label="Pagination">
          <%== pagy_info(@pagy) %>
          <%== pagy_nav(@pagy) %>
        </nav>
      <% end %>
    <% else %>
      <div class="text-center py-16 glass rounded-2xl">
        <% if @query || @tag %>
          <p class="text-mist-300 mb-4">No links match.</p>
          <%= link_to "Clear filters", links_path, class: "btn-ghost" %>
        <% else %>
          <p class="text-mist-300 mb-1">Your library is empty.</p>
          <p class="text-sm text-mist-400 mb-5">Save your first link to get an AI summary in seconds.</p>
          <%= link_to "Save your first link", new_link_path, class: "btn-primary" %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
