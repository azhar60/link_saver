<% content_for :title, @link.title.presence || "Showing link" %>

<%
  status_classes = {
    "ready"      => "bg-green-100 text-green-700",
    "processing" => "bg-blue-100 text-blue-700",
    "failed"     => "bg-red-100 text-red-700",
    "pending"    => "bg-gray-100 text-gray-600"
  }
%>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-700 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <% if @link.pending? || @link.processing? %>
    <div class="mb-5 p-4 bg-blue-50 border border-blue-200 rounded-md text-blue-800 flex items-center gap-3">
      <svg class="animate-spin h-5 w-5 text-blue-600 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4l3-3-3-3v4a8 8 0 100 16v-4l-3 3 3 3v-4a8 8 0 01-8-8z"></path>
      </svg>
      <div>
        <strong class="font-semibold">Processing this link…</strong>
        <p class="text-sm">Fetching the page and asking the AI for a summary. Refresh in a moment.</p>
      </div>
    </div>
  <% elsif @link.failed? %>
    <div class="mb-5 p-4 bg-red-50 border border-red-200 rounded-md flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div class="text-red-800">
        <strong class="font-semibold">Couldn't summarize this page.</strong>
        <p class="text-sm">The page might be unreachable or the AI service is unavailable.</p>
      </div>
      <%= button_to "Retry summary", regenerate_link_path(@link), method: :post, class: "shrink-0 rounded-md px-3.5 py-2.5 bg-red-600 hover:bg-red-500 text-white font-medium cursor-pointer" %>
    </div>
  <% end %>

  <div id="<%= dom_id(@link) %>" class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm mb-5">
    <div class="flex items-start justify-between gap-3 mb-3">
      <h1 class="font-bold text-2xl text-gray-900"><%= @link.title.presence || @link.url %></h1>
      <span class="shrink-0 text-xs font-medium px-2 py-0.5 rounded-full <%= status_classes[@link.status] %>"><%= @link.status %></span>
    </div>

    <p class="text-sm text-gray-500 break-all mb-4">
      <%= link_to @link.url, @link.url, target: "_blank", rel: "noopener", class: "hover:text-blue-600 hover:underline" %>
    </p>

    <% if @link.summary.present? %>
      <div class="mb-4">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1">Summary</h2>
        <p class="text-gray-800 leading-relaxed"><%= @link.summary %></p>
      </div>
    <% end %>

    <% if @link.tag_list.any? %>
      <div>
        <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-2">Tags</h2>
        <%= render "tag_chips", link: @link %>
      </div>
    <% end %>
  </div>

  <%= link_to "Edit this link", edit_link_path(@link), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= button_to "Regenerate summary", regenerate_link_path(@link), method: :post, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "w-full rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
  <%= link_to "Back to links", links_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= button_to "Destroy this link", @link, method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "w-full rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
</div>
