<%
  status_chip = {
    "ready"      => "chip-ready",
    "processing" => "chip-processing",
    "pending"    => "chip-pending",
    "failed"     => "chip-failed"
  }[link.status] || "chip"
%>
<article id="<%= dom_id(link) %>" class="glass rounded-2xl p-5 transition hover:border-white/15 hover:shadow-glass group">
  <div class="flex items-start justify-between gap-3 mb-2">
    <h2 class="font-semibold text-[1.05rem] leading-snug text-mist-100 line-clamp-2">
      <%= link_to (link.title.presence || link.url), link, class: "hover:text-white transition", id: "title-#{dom_id(link)}" %>
    </h2>
    <span class="chip <%= status_chip %> shrink-0"><%= link.status %></span>
  </div>

  <p class="text-xs text-mist-400 truncate mb-1"><%= link.url %></p>
  <p class="text-[11px] text-mist-500 mb-3">
    <% if (mins = link.reading_time_minutes) %>
      <%= mins %> min read
    <% else %>
      &nbsp;
    <% end %>
  </p>

  <% if link.summary.present? %>
    <p class="text-sm text-mist-300 leading-relaxed line-clamp-3 mb-3"><%= link.summary %></p>
  <% end %>

  <%= render "tag_chips", link: link %>

  <div class="mt-4 pt-3 border-t border-white/5 flex justify-end opacity-0 group-hover:opacity-100 transition">
    <% if link.archived? %>
      <%= button_to "Restore", link_archive_path(link), method: :delete, class: "text-xs text-mist-400 hover:text-mist-100 transition cursor-pointer" %>
    <% else %>
      <%= button_to "Archive", link_archive_path(link), method: :post, class: "text-xs text-mist-400 hover:text-mist-100 transition cursor-pointer" %>
    <% end %>
  </div>
</article>
