<%= form_with(model: link, class: "contents", data: { controller: "link-form" }) do |form| %>
  <% if link.errors.any? %>
    <div class="alert alert-error mb-5">
      <p class="font-semibold mb-1"><%= pluralize(link.errors.count, "error") %> prohibited this link from being saved:</p>
      <ul class="list-disc ml-5 space-y-0.5 opacity-90">
        <% link.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-5">
    <div>
      <%= form.label :url, class: "block text-xs font-medium uppercase tracking-wider text-mist-400 mb-1.5" %>
      <%= form.text_field :url, placeholder: "https://...", class: "input #{'input-error' if link.errors[:url].any?}" %>
    </div>

    <div>
      <%= form.label :title, class: "block text-xs font-medium uppercase tracking-wider text-mist-400 mb-1.5" %>
      <%= form.text_field :title, placeholder: "Leave blank to auto-fetch", class: "input #{'input-error' if link.errors[:title].any?}" %>
    </div>

    <div>
      <%= form.label :summary, class: "block text-xs font-medium uppercase tracking-wider text-mist-400 mb-1.5" %>
      <%= form.textarea :summary, rows: 4, placeholder: "Leave blank to let Gemini summarize", class: "input #{'input-error' if link.errors[:summary].any?}" %>
    </div>

    <div>
      <%= form.label :tags, class: "block text-xs font-medium uppercase tracking-wider text-mist-400 mb-1.5" %>
      <%= form.text_field :tags, placeholder: "ruby, rails, hotwire", class: "input #{'input-error' if link.errors[:tags].any?}" %>
    </div>
  </div>

  <div class="mt-7 flex gap-2">
    <%= form.button class: "btn-primary disabled:cursor-wait", data: { link_form_target: "submit" } do %>
      <%= link.new_record? ? "Save link" : "Update link" %>
    <% end %>
    <%= link_to "Cancel", (link.persisted? ? link : links_path), class: "btn-ghost" %>
  </div>
<% end %>
