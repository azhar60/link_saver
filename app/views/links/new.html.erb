<% content_for :title, "New link" %>

<div class="max-w-2xl mx-auto">
  <div class="mb-6">
    <h1 class="text-3xl font-bold tracking-tight">
      <span class="text-gradient">Save a link</span>
    </h1>
    <p class="text-sm text-mist-400 mt-1">Paste a URL. We'll fetch the page, summarize it, and tag it for you.</p>
  </div>

  <div class="glass-strong rounded-2xl p-6 sm:p-8 shadow-glass">
    <%= render "form", link: @link %>
  </div>
</div>
