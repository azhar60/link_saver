<% content_for :title, "Bookmarklet" %>

<%
  target = new_link_url
  bookmarklet_js = "javascript:(function(){var u=encodeURIComponent(location.href);var t=encodeURIComponent(document.title);window.open('#{target}?link%5Burl%5D='+u+'&link%5Btitle%5D='+t,'_blank');})();"
%>

<div class="max-w-2xl mx-auto">
  <%= link_to links_path, class: "inline-flex items-center gap-1.5 text-sm text-mist-400 hover:text-mist-100 mb-4 transition" do %>
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    Back to library
  <% end %>

  <h1 class="text-3xl font-bold tracking-tight"><span class="text-gradient">Bookmarklet</span></h1>
  <p class="text-mist-400 mt-1 mb-6">One-click save from any page. Drag the button to your bookmarks bar.</p>

  <div class="glass-strong rounded-2xl p-6 sm:p-8 shadow-glass mb-5">
    <p class="text-xs uppercase tracking-wider text-mist-400 mb-3">Drag to your bookmarks bar</p>
    <%= raw %(<a href="#{ERB::Util.html_escape(bookmarklet_js)}" class="btn-primary cursor-grab active:cursor-grabbing select-none">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
      Save to Link Saver
    </a>) %>
  </div>

  <div class="glass rounded-xl p-5 text-sm text-mist-300">
    <p class="font-semibold text-mist-100 mb-2">How to install</p>
    <ol class="list-decimal ml-5 space-y-1 text-mist-400">
      <li>Make sure your browser's bookmarks bar is visible.</li>
      <li>Drag the button above onto your bookmarks bar.</li>
      <li>On any page you want to save, click the bookmark — a pre-filled <em>Save</em> form opens.</li>
      <li>Click <strong class="text-mist-100">Save link</strong>; the page is fetched and summarized in the background.</li>
    </ol>
  </div>

  <details class="mt-4 text-sm">
    <summary class="text-mist-400 cursor-pointer hover:text-mist-100">Raw bookmarklet code</summary>
    <pre class="mt-2 p-3 glass rounded-lg overflow-x-auto text-[12px] text-mist-200 font-mono"><%= bookmarklet_js %></pre>
    <p class="text-xs text-mist-500 mt-1.5">Create a new bookmark and paste this as the URL if dragging doesn't work.</p>
  </details>
</div>
