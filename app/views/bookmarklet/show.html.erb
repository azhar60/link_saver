<% content_for :title, "Bookmarklet" %>

<%
  target = new_link_url
  bookmarklet_js = "javascript:(function(){var u=encodeURIComponent(location.href);var t=encodeURIComponent(document.title);window.open('#{target}?link%5Burl%5D='+u+'&link%5Btitle%5D='+t,'_blank');})();"
%>

<div class="md:w-2/3 w-full p-4">
  <div class="mb-6">
    <%= link_to "← Back to links", links_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <h1 class="font-bold text-3xl text-gray-900 mb-2">Bookmarklet</h1>
  <p class="text-gray-600 mb-6">One-click save from any page. Drag the button below to your bookmarks bar; click it on any page to save that URL to your Link Saver.</p>

  <div class="p-6 bg-white border border-gray-200 rounded-lg shadow-sm mb-6">
    <p class="text-sm text-gray-500 mb-3">Drag this to your bookmarks bar:</p>
    <%= raw %(<a href="#{ERB::Util.html_escape(bookmarklet_js)}" class="inline-block rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-grab active:cursor-grabbing">📎 Save to Link Saver</a>) %>
  </div>

  <div class="p-4 bg-gray-50 border border-gray-200 rounded-md text-sm text-gray-700 space-y-2">
    <p class="font-semibold">How to install</p>
    <ol class="list-decimal ml-5 space-y-1">
      <li>Make sure your browser's bookmarks bar is visible (View → Show Bookmarks Bar).</li>
      <li>Drag the blue button above onto your bookmarks bar. A new bookmark appears.</li>
      <li>On any page you want to save, click the bookmark. A pre-filled <em>New link</em> form opens in this app.</li>
      <li>Click <strong>Create Link</strong> — the page is fetched and summarized in the background.</li>
    </ol>
  </div>

  <details class="mt-4">
    <summary class="text-sm text-gray-500 cursor-pointer hover:text-gray-700">Raw bookmarklet code (if dragging doesn't work)</summary>
    <pre class="mt-2 p-3 bg-gray-900 text-gray-100 text-xs rounded-md overflow-x-auto"><%= bookmarklet_js %></pre>
    <p class="text-xs text-gray-500 mt-1">Create a new bookmark and paste this as the URL.</p>
  </details>
</div>
